FROM node:20-bookworm-slim AS build

WORKDIR /app

# Explicit copies keep the assignment-root .env and provider keys outside the
# image. The gateway receives only its non-provider settings through Fly.
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/contract/package.json packages/contract/tsconfig.json ./packages/contract/
COPY backend/gateway/package.json backend/gateway/tsconfig.json ./backend/gateway/
COPY web/package.json web/tsconfig.json web/vite.config.ts web/index.html ./web/
RUN npm ci --workspace @lumina/contract --workspace @lumina/gateway --workspace @lumina/web --include-workspace-root

COPY packages/contract/src ./packages/contract/src
COPY backend/gateway/src ./backend/gateway/src
COPY web/src ./web/src
RUN npm run build -w @lumina/contract && npm run build -w @lumina/gateway && npm run build -w @lumina/web

FROM node:20-bookworm-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/contract/package.json ./packages/contract/package.json
COPY --from=build /app/packages/contract/dist ./packages/contract/dist
COPY --from=build /app/backend/gateway/package.json ./backend/gateway/package.json
COPY --from=build /app/backend/gateway/dist ./backend/gateway/dist
COPY --from=build /app/web/dist ./web/dist
RUN mkdir -p /app/reports
# Generated by the provided eval builder; never manually assign evaluation scores.
COPY reports/report.json /app/reports/report.json

WORKDIR /app/backend/gateway
CMD ["node", "dist/index.js"]
